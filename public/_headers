# Security headers for static hosts that read a _headers file
# (Netlify, Cloudflare Pages). On other hosts, set the same headers in their
# settings. These were tested against every page of the app with zero violations.
# If you self-host the fonts, remove the two Google Fonts hosts below.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
